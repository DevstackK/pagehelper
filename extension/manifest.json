{
  "manifest_version": 3,
  "name": "Page Answer Helper",
  "version": "0.1.6",
  "description": "Scan questions, select answers, and advance through supported pages.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://page-answer-helper.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": ["https://page-answer-helper.vercel.app/*"]
  },
  "action": {
    "default_title": "Open Page Answer Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
